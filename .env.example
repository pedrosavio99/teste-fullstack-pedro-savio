# ===== Identidade do usuário do container (não-root) =====
# Use os IDs do seu usuário no host (descubra com: id -u / id -g)
UID=1000
GID=1000

# ===== Portas expostas no host =====
APP_PORT=8000
DB_PORT=3306
REDIS_PORT=6379
N8N_PORT=5678

# ===== Banco de dados (MySQL) =====
DB_DATABASE=ecommerce
DB_USERNAME=app_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_IN_PRODUCTION

# ===== N8N (automação de workflows) =====
# Login do painel do N8N (http://localhost:5678)
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_IN_PRODUCTION
# URL pública base que o N8N usa para montar os endereços dos webhooks
N8N_WEBHOOK_URL=http://localhost:5678/
